generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum TipoStockOperacion {
  INGRESO
  EGRESO

  @@map("tipo_stock_operacion")
}

enum UserRole {
  ADMIN
  EDITOR
  READ_ONLY

  @@map("user_role")
}

enum TipoPersonal {
  SUBALTERNO
  OFICIAL
  SUBOFICIAL

  @@map("tipo_personal")
}

enum TipoArticulo {
  OFICINA
  LIMPIEZA

  @@map("tipo_articulo")
}

enum TipoArticuloStockMovimiento {
  INGRESO
  EGRESO

  @@map("tipo_articulo_stock_movimiento")
}

enum TipoMovimiento {
  ENTREGA
  DEVOLUCION
  PRESTAMO

  @@map("tipo_movimiento")
}

enum EstadoPrestamoMovimiento {
  PENDIENTE
  DEVUELTO

  @@map("estado_prestamo_movimiento")
}

enum EstadoEquipoPrestamo {
  NUEVO
  BUENO
  REGULAR
  MALO

  @@map("estado_equipo_prestamo")
}

enum PrioridadRecordatorio {
  NORMAL
  URGENTE

  @@map("prioridad_recordatorio")
}

model Usuario {
  usuarioId                       String              @id @default(cuid()) @map("usuario_id")
  rangoId                         Int                 @map("grado_id") @db.SmallInt
  nombre                          String
  apellido                        String
  username                        String              @unique @map("usuario")
  passwordHash                    String              @map("password_hash")
  mailReferencia                  String?             @map("mail_referencia")
  mailVerificadaAt                DateTime?           @map("mail_verificada_at") @db.Timestamptz(6)
  rol                             UserRole            @default(EDITOR)
  activo                          Boolean             @default(true)
  createdAt                       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sesiones                        Sesion[]
  auditorias                      Auditoria[]
  resetCodes                      PasswordResetCode[]
  rango                           Rango               @relation(fields: [rangoId], references: [rangoId])
  movimientosEntregados           Movimiento[]        @relation("movimiento_usuario_entrega")
  articuloEntregasRealizadas      ArticuloEntregaPersonal[] @relation("articulo_entrega_usuario")
  devolucionesPrestamoRegistradas PrestamoHistorial[] @relation("prestamo_historial_usuario_recepcion")
  recordatorioConfig              UsuarioRecordatorioConfig?
  recordatorioTareas              UsuarioRecordatorioTarea[]

  @@index([rangoId])
  @@map("usuario")
}

model UsuarioRecordatorioConfig {
  usuarioId     String   @id @map("usuario_id")
  mostrarMuneco Boolean  @default(true) @map("mostrar_muneco")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  usuario       Usuario  @relation(fields: [usuarioId], references: [usuarioId], onDelete: Cascade)

  @@map("usuario_recordatorio_config")
}

model UsuarioRecordatorioTarea {
  tareaId      BigInt                @id @default(autoincrement()) @map("tarea_id")
  usuarioId    String                @map("usuario_id")
  titulo       String
  nota         String?
  fechaLimite  DateTime?             @map("fecha_limite") @db.Date
  prioridad    PrioridadRecordatorio @default(NORMAL)
  completada   Boolean               @default(false)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  usuario      Usuario               @relation(fields: [usuarioId], references: [usuarioId], onDelete: Cascade)

  @@index([usuarioId, completada, prioridad, fechaLimite])
  @@map("usuario_recordatorio_tarea")
}

model PasswordResetCode {
  resetId   String    @id @default(cuid()) @map("reset_id")
  usuarioId String    @map("usuario_id")
  codeHash  String    @map("code_hash")
  tokenType String    @default("PASSWORD_RESET") @map("token_type")
  mailSnapshot String? @map("mail_snapshot")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usuario   Usuario   @relation(fields: [usuarioId], references: [usuarioId], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@index([tokenType, expiresAt])
  @@map("password_reset")
}

model Sesion {
  sesionId  String   @id @default(cuid()) @map("sesion_id")
  tokenHash String   @unique @map("token_hash")
  usuarioId String   @map("usuario_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  usuario   Usuario  @relation(fields: [usuarioId], references: [usuarioId], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("sesion")
}

model Auditoria {
  auditoriaId BigInt   @id @default(autoincrement()) @map("auditoria_id")
  usuarioId   String?  @map("usuario_id")
  accion      String
  entidad     String
  entidadId   String?  @map("entidad_id")
  detalle     Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  usuario     Usuario? @relation(fields: [usuarioId], references: [usuarioId], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([usuarioId, createdAt(sort: Desc)])
  @@map("auditoria")
}

model Rango {
  rangoId        Int          @id @default(autoincrement()) @map("grado_id") @db.SmallInt
  tipo           TipoPersonal
  abreviacion    String
  nombreCompleto String       @map("nombre_completo")
  orden          Int          @map("orden") @db.SmallInt
  personal       Personal[]
  usuarios       Usuario[]

  @@unique([tipo, abreviacion])
  @@unique([tipo, nombreCompleto])
  @@unique([rangoId, tipo])
  @@index([tipo, orden])
  @@index([orden])
  @@map("grado")
}

model Bateria {
  bateriaId   Int          @id @default(autoincrement()) @map("bateria_id") @db.SmallInt
  nombre      String       @unique
  orden       Int          @map("orden") @db.SmallInt
  subalternos Subalterno[]

  @@index([orden])
  @@map("bateria")
}

model Articulo {
  articuloId       Int                      @id @default(autoincrement()) @map("articulo_id") @db.SmallInt
  nombre           String                   @unique
  tipo             TipoArticulo
  movimientosStock ArticuloStockMovimiento[]

  @@index([tipo])
  @@map("articulo")
}

model ArticuloEntregaPersonal {
  articuloEntregaPersonalId BigInt                    @id @default(autoincrement()) @map("articulo_entrega_personal_id")
  personalCi                String                    @map("personal_ci")
  usuarioEntregaId          String                    @map("usuario_entrega_id")
  ordenanteCi               String                    @map("ordenante_ci")
  fecha                     DateTime                  @db.Date
  comentario                String?
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  personal                  Personal                  @relation("articulo_entrega_destinatario", fields: [personalCi], references: [ci], onDelete: Restrict)
  usuarioEntrega            Usuario                   @relation("articulo_entrega_usuario", fields: [usuarioEntregaId], references: [usuarioId], onDelete: Restrict)
  ordenante                 Personal                  @relation("articulo_entrega_ordenante", fields: [ordenanteCi], references: [ci], onDelete: Restrict)
  movimientosStock          ArticuloStockMovimiento[]

  @@index([personalCi, fecha(sort: Desc)])
  @@index([usuarioEntregaId, fecha(sort: Desc)])
  @@index([ordenanteCi, fecha(sort: Desc)])
  @@map("articulo_entrega_personal")
}

model ArticuloStockMovimiento {
  articuloStockMovimientoId BigInt                   @id @default(autoincrement()) @map("articulo_stock_movimiento_id")
  articuloId                Int                      @map("articulo_id") @db.SmallInt
  tipo                      TipoArticuloStockMovimiento
  cantidad                  Int
  comentario                String?
  articuloEntregaPersonalId BigInt?                  @map("articulo_entrega_personal_id")
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  articulo                  Articulo                 @relation(fields: [articuloId], references: [articuloId], onDelete: Restrict)
  articuloEntregaPersonal   ArticuloEntregaPersonal? @relation(fields: [articuloEntregaPersonalId], references: [articuloEntregaPersonalId], onDelete: Restrict)

  @@index([articuloId, createdAt(sort: Desc)])
  @@index([tipo, createdAt(sort: Desc)])
  @@index([articuloEntregaPersonalId, createdAt(sort: Desc)])
  @@map("articulo_stock_movimiento")
}

model Estanteria {
  codigo String @db.VarChar(1)
  piso   Int    @db.SmallInt
  cajas  Caja[]

  @@id([codigo, piso])
  @@map("estanteria")
}

model TallaTipo {
  tallaTipoId Int             @id @default(autoincrement()) @map("talla_tipo_id") @db.SmallInt
  nombre      String          @unique
  tallas      PersonalTalla[]

  @@map("talla_tipo")
}

model Item {
  itemId              BigInt               @id @default(autoincrement()) @map("item_id")
  nombre              String               @unique
  activo              Boolean              @default(true)
  ordenPdf            Int                  @map("orden_pdf")
  existenciaSie       Int                  @default(0) @map("existencia_sie")
  movimientoItems     MovimientoItem[]
  stockOperacionItems StockOperacionItem[]
  codigosSIE          ItemCodigoSIE[]
  cajas               CajaItem[]

  @@map("item")
}

model ItemCodigoSIE {
  itemCodigoSIEId BigInt             @id @default(autoincrement()) @map("item_codigo_sie_id")
  codigo          String
  talla           String             @default("-")
  itemId          BigInt             @map("item_id")
  item            Item               @relation(fields: [itemId], references: [itemId], onDelete: Cascade)
  cajas           CajaItemCodigoSIE[]

  @@index([itemId])
  @@index([codigo])
  @@unique([codigo, talla, itemId])
  @@map("item_codigo_sie")
}

model Caja {
  codigoDepositoGeneral Int               @id @map("codigo_deposito_general")
  estanteria            String            @db.VarChar(1)
  piso                  Int               @db.SmallInt
  estanteriaRef         Estanteria        @relation(fields: [estanteria, piso], references: [codigo, piso])
  items                 CajaItem[]
  codigosSIE            CajaItemCodigoSIE[]

  @@index([estanteria, piso])
  @@map("caja")
}

model CajaItem {
  codigoDepositoGeneral Int    @map("codigo_deposito_general")
  itemId                BigInt @map("item_id")
  cantidad              Int    @default(1)
  caja                  Caja   @relation(fields: [codigoDepositoGeneral], references: [codigoDepositoGeneral], onDelete: Cascade)
  item                  Item   @relation(fields: [itemId], references: [itemId], onDelete: Restrict)

  @@id([codigoDepositoGeneral, itemId])
  @@index([itemId])
  @@map("caja_item")
}

model CajaItemCodigoSIE {
  codigoDepositoGeneral Int           @map("codigo_deposito_general")
  itemCodigoSIEId       BigInt        @map("item_codigo_sie_id")
  caja                  Caja          @relation(fields: [codigoDepositoGeneral], references: [codigoDepositoGeneral], onDelete: Cascade)
  itemCodigoSIE         ItemCodigoSIE @relation(fields: [itemCodigoSIEId], references: [itemCodigoSIEId], onDelete: Cascade)

  @@id([codigoDepositoGeneral, itemCodigoSIEId])
  @@index([itemCodigoSIEId])
  @@map("caja_item_codigo_sie")
}

model Personal {
  ci               String          @id @map("ci")
  apellido1        String
  apellido2        String?
  nombre1          String
  nombre2          String?
  telefonoContacto String?         @map("telefono_contacto")
  rangoId          Int             @map("grado_id") @db.SmallInt
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rango            Rango           @relation(fields: [rangoId], references: [rangoId])
  subalterno       Subalterno?
  oficial          Oficial?
  suboficial       Suboficial?
  tallas           PersonalTalla[]
  movimientos      Movimiento[]
  articuloEntregasRecibidas ArticuloEntregaPersonal[] @relation("articulo_entrega_destinatario")
  articuloEntregasOrdenadas ArticuloEntregaPersonal[] @relation("articulo_entrega_ordenante")
  observaciones    Observacion[]

  @@index([rangoId])
  @@map("personal")
}

model Movimiento {
  movimientoId      BigInt             @id @default(autoincrement()) @map("movimiento_id")
  tipo              TipoMovimiento
  fecha             DateTime           @db.Date
  personalCi        String             @map("personal_ci")
  usuarioEntregaId  String             @map("usuario_entrega_id")
  afectaStock       Boolean            @default(true) @map("afecta_stock")
  observaciones     String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  personal          Personal           @relation(fields: [personalCi], references: [ci], onDelete: Cascade)
  usuarioEntrega    Usuario            @relation("movimiento_usuario_entrega", fields: [usuarioEntregaId], references: [usuarioId])
  items             MovimientoItem[]
  prestamoActivo    PrestamoActivo?
  prestamoHistorial PrestamoHistorial?

  @@index([personalCi, fecha(sort: Desc)])
  @@index([tipo, fecha(sort: Desc)])
  @@index([usuarioEntregaId, fecha(sort: Desc)])
  @@map("movimiento")
}

model MovimientoItem {
  movimientoId         BigInt               @map("movimiento_id")
  itemId               BigInt               @map("item_id")
  cantidad             Int
  estadoEntrega        EstadoEquipoPrestamo @default(BUENO) @map("estado_entrega")
  comentarioEntrega    String?              @map("comentario_entrega")
  estadoDevolucion     EstadoEquipoPrestamo? @map("estado_devolucion")
  comentarioDevolucion String?              @map("comentario_devolucion")
  movimiento           Movimiento           @relation(fields: [movimientoId], references: [movimientoId], onDelete: Cascade)
  item                 Item                 @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@id([movimientoId, itemId])
  @@index([itemId])
  @@map("movimiento_item")
}

model PrestamoActivo {
  movimientoId                  BigInt                   @id @map("movimiento_id")
  reciboNumero                  String                   @unique @map("recibo_numero")
  estado                        EstadoPrestamoMovimiento @default(PENDIENTE)
  fechaEstimadaDevolucionTexto  String?                  @map("fecha_estimada_devolucion_texto")
  createdAt                     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  movimiento                    Movimiento               @relation(fields: [movimientoId], references: [movimientoId], onDelete: Cascade)

  @@index([estado, createdAt(sort: Desc)])
  @@map("prestamo_activo")
}

model PrestamoHistorial {
  historialId               BigInt                   @id @default(autoincrement()) @map("historial_id")
  movimientoId              BigInt                   @unique @map("movimiento_id")
  reciboNumero              String                   @unique @map("recibo_numero")
  estado                    EstadoPrestamoMovimiento @default(DEVUELTO)
  fechaDevolucion           DateTime                 @map("fecha_devolucion") @db.Date
  fechaEstimadaDevolucionTexto String?               @map("fecha_estimada_devolucion_texto")
  usuarioRecibeDevolucionId String?                  @map("usuario_recibe_devolucion_id")
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  movimiento                Movimiento               @relation(fields: [movimientoId], references: [movimientoId], onDelete: Cascade)
  usuarioRecibeDevolucion   Usuario?                 @relation("prestamo_historial_usuario_recepcion", fields: [usuarioRecibeDevolucionId], references: [usuarioId], onDelete: SetNull)

  @@index([fechaDevolucion(sort: Desc)])
  @@index([usuarioRecibeDevolucionId, fechaDevolucion(sort: Desc)])
  @@map("prestamo_historial")
}

model Subalterno {
  ci                   String    @id @map("ci")
  esReingreso          Boolean   @default(false) @map("es_reingreso")
  fechaIngreso         DateTime? @map("fecha_ingreso") @db.Date
  fechaIngresoOriginal DateTime? @map("fecha_ingreso_original") @db.Date
  bateriaId            Int?      @map("bateria_id") @db.SmallInt
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  personal             Personal  @relation(fields: [ci], references: [ci], onDelete: Cascade)
  bateria              Bateria?  @relation(fields: [bateriaId], references: [bateriaId])

  @@index([bateriaId])
  @@map("subalterno")
}

model Oficial {
  ci        String   @id @map("ci")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  personal  Personal @relation(fields: [ci], references: [ci], onDelete: Cascade)

  @@map("oficial")
}

model Suboficial {
  ci        String   @id @map("ci")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  personal  Personal @relation(fields: [ci], references: [ci], onDelete: Cascade)

  @@map("suboficial")
}

model PersonalTalla {
  ci          String    @map("ci")
  tallaTipoId Int       @map("talla_tipo_id") @db.SmallInt
  tallaValor  String    @map("talla_valor")
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  personal    Personal  @relation(fields: [ci], references: [ci], onDelete: Cascade)
  tallaTipo   TallaTipo @relation(fields: [tallaTipoId], references: [tallaTipoId])

  @@id([ci, tallaTipoId])
  @@map("personal_talla")
}

model Observacion {
  observacionId BigInt   @id @default(autoincrement()) @map("observacion_id")
  ci            String   @map("ci")
  fecha         DateTime @db.Date
  texto         String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  personal      Personal @relation(fields: [ci], references: [ci], onDelete: Cascade)

  @@index([ci, fecha(sort: Desc)])
  @@map("observacion")
}

model StockOperacion {
  stockOperacionId BigInt               @id @default(autoincrement()) @map("stock_operacion_id")
  fecha            DateTime             @db.Date
  tipo             TipoStockOperacion
  comentarios      String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  items            StockOperacionItem[]

  @@index([fecha(sort: Desc)])
  @@map("stock_operacion")
}

model StockOperacionItem {
  stockOperacionId BigInt         @map("stock_operacion_id")
  itemId           BigInt         @map("item_id")
  cantidad         Int
  stockOperacion   StockOperacion @relation(fields: [stockOperacionId], references: [stockOperacionId], onDelete: Cascade)
  item             Item           @relation(fields: [itemId], references: [itemId])

  @@id([stockOperacionId, itemId])
  @@index([itemId])
  @@map("stock_operacion_item")
}

model ConfigFirma {
  id              Int      @id @default(1)
  encargadoRango  String   @map("encargado_rango")
  encargadoNombre String   @map("encargado_nombre")
  oficialRango    String   @map("oficial_rango")
  oficialNombre   String   @map("oficial_nombre")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("config_firma")
}
