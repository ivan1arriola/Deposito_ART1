{
  "name": "deposito-art1",
  "version": "6.9.5",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "predev": "prisma generate",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "prebuild": "npm run check:encoding && prisma generate && cross-env NODE_ENV=development vitest run",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "dep:check": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip --treat-config-hints-as-errors",
    "check:security": "node scripts/check-security-hygiene.mjs",
    "qa:strict": "npm run typecheck && npm run lint && npm run format:check && npm run dep:check && npm run knip && npm run check:encoding && npm run check:spanish && npm run refactor:gate && npm run check:security && npx vitest run --coverage",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pdf": "playwright test tests/e2e/print-a4-pdf.spec.ts",
    "refactor:scan": "node scripts/refactor-metrics.mjs",
    "refactor:scan:json": "node scripts/refactor-metrics.mjs --format json --out reports/refactor-metrics.json",
    "refactor:gate": "node scripts/refactor-metrics.mjs --fail-on-high-risk",
    "check:encoding": "node scripts/check-utf8.mjs",
    "check:encoding:fix": "node scripts/check-utf8.mjs --fix-bom",
    "check:spanish": "node scripts/check-spanish-integrity.mjs",
    "check:spanish:fix": "node scripts/check-spanish-integrity.mjs --fix",
    "precommit": "node scripts/bump-version-precommit.mjs",
    "prisma:generate": "prisma generate",
    "db:rebuild": "prisma db execute --file prisma/schema-base.sql && prisma generate",
    "db:patch:drop-caja-cantidad": "prisma db execute --file prisma/patches/20260427_drop_caja_cantidad.sql && prisma generate",
    "db:patch:add-caja-piso-fk": "prisma db execute --file prisma/patches/20260427_add_caja_piso_fk.sql && prisma generate",
    "db:patch:drop-personal-tipo": "prisma db execute --file prisma/patches/20260427_drop_personal_tipo_use_rango.sql && prisma generate",
    "db:patch:add-item-existencia-sie": "prisma db execute --file prisma/patches/20260502_add_item_existencia_sie.sql && prisma generate",
    "db:patch:add-item-tipo": "prisma db execute --file prisma/patches/20260524_add_item_tipo.sql && prisma generate",
    "db:patch:refactor-tipo-equipo": "prisma db execute --file prisma/patches/20260531_refactor_tipo_equipo.sql && prisma generate",
    "db:patch:rename-item-to-equipos-table": "prisma db execute --file prisma/patches/20260531_rename_item_table_to_equipos.sql && prisma generate",
    "db:patch:usuario-sin-grado-desarrollador": "prisma db execute --file prisma/patches/20260531_usuario_sin_grado_desarrollador.sql && prisma generate",
    "db:patch:add-articulos": "prisma db execute --file prisma/patches/20260520_add_articulos.sql && prisma generate",
    "db:patch:add-articulos-stock-actual": "prisma db execute --file prisma/patches/20260520_add_articulos_stock_actual.sql && prisma generate",
    "db:patch:add-articulo-stock-movimiento": "prisma db execute --file prisma/patches/20260520_add_articulo_stock_movimiento.sql && prisma generate",
    "db:patch:add-articulo-entrega-personal": "prisma db execute --file prisma/patches/20260520_add_articulo_entrega_personal.sql && prisma generate",
    "db:patch:add-movimiento-destinatario-recinto": "prisma db execute --file prisma/patches/20260526_add_movimiento_destinatario_recinto.sql && prisma generate",
    "db:patch:add-movimiento-asignacion": "prisma db execute --file prisma/patches/20260526_add_movimiento_asignacion.sql && prisma generate",
    "prisma:studio": "prisma studio",
    "user:create": "tsx scripts/create-user.ts",
    "docs:producto": "node scripts/generate-product-presentation-pdf.mjs",
    "webpush:generate": "node scripts/generate-webpush-keys.mjs",
    "licenses": "license-checker-rseidelsohn --json --out licenses.json",
    "licenses:summary": "license-checker-rseidelsohn --summary",
    "licenses:prod": "license-checker-rseidelsohn --production --json --out licenses-prod.json",
    "docs:manual": "python3 scripts/generate_user_manual.py",
    "licenses:check": "license-checker-rseidelsohn --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-3-Clause;BSD-2-Clause;Apache-2.0;0BSD;CC-BY-4.0;(MIT AND Zlib);MIT*;Apache-2.0 AND LGPL-3.0-or-later\"",
    "licenses:check:prod": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-3-Clause;BSD-2-Clause;Apache-2.0;0BSD;CC-BY-4.0;(MIT AND Zlib);MIT*;Apache-2.0 AND LGPL-3.0-or-later\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.3.2",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "ciuy": "^1.0.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.82.0",
    "next": "16.2.2",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.9.0",
    "dotenv": "^17.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.1.1",
    "knip": "^6.48.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.10.1",
    "prisma": "^7.7.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
