  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "npm run check:encoding && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "check:encoding": "node scripts/check-utf8.mjs",
    "prisma:generate": "prisma generate",
    "db:rebuild": "prisma db execute --schema prisma/schema.prisma --file prisma/schema-base.sql && prisma generate",
    "prisma:studio": "prisma studio",
    "user:create": "node scripts/create-user.mjs",
    "webpush:generate": "node scripts/generate-webpush-keys.mjs",
    "licenses": "license-checker --json --out licenses.json",
    "licenses:summary": "license-checker --summary",
    "licenses:prod": "license-checker --production --json --out licenses-prod.json",
    "licenses:check": "license-checker --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-3-Clause;BSD-2-Clause;Apache-2.0;0BSD;CC-BY-4.0;(MIT AND Zlib);MIT*;Apache-2.0 AND LGPL-3.0-or-later\"",
    "licenses:check:prod": "license-checker --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-3-Clause;BSD-2-Clause;Apache-2.0;0BSD;CC-BY-4.0;(MIT AND Zlib);MIT*;Apache-2.0 AND LGPL-3.0-or-later\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.17.1",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "ciuy": "^1.0.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "license-checker": "^25.0.1",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
